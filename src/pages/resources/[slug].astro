---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { resources, SITE } from '../../data/site';

export function getStaticPaths() {
  return resources.map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}

const { resource } = Astro.props;
const breadcrumbs = [
  { name: 'ホーム', href: '/' },
  { name: 'リソース', href: '/resources' },
  { name: resource.title, href: `/resources/${resource.slug}` },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: resource.title,
  description: resource.description,
  image: new URL(resource.image, Astro.site).href,
  inLanguage: 'ja',
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}/resources/${resource.slug}` },
};
---

<Layout
  title={`${resource.title} | 墨泰研磨材`}
  description={`${resource.title}：購買チームが正確な仕様を準備するための実践情報と、墨泰連絡前の明確な手順。`}
  image={resource.image}
  breadcrumbs={breadcrumbs}
  jsonLd={[articleJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="page-hero page-hero--image">
    <div class="container page-hero__inner">
      <span class="eyebrow eyebrow--light">{resource.type}</span>
      <h1>{resource.title}</h1>
      <p>{resource.description}</p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container resource-layout">
      <article class="resource-article">
        <div class="content-block">
          <span class="eyebrow">実践サマリー</span>
          <h2>このガイドが決めること</h2>
          <p>
            {resource.description} この情報を使用してより具体的な依頼を準備すると、
            連絡回数を減らし、最適な仕様と見積により早く到達できます。
          </p>
        </div>
        {
          resource.sections.map((section, index) => (
            <div class="content-block">
              <span class="eyebrow">セクション {index + 1}</span>
              <h2>{section.title}</h2>
              <ol class="numbered-list">
                {section.items.map((item) => <li>{item}</li>)}
              </ol>
            </div>
          ))
        }
        <div class="content-block">
          <span class="eyebrow">次のステップ</span>
          <h2>情報を見積可能な仕様に変える</h2>
          <p>
            リストが準備できたら、数量と納品先を添えて問い合わせフォームから送信してください。
            確認のうえ、貴社加工に合う内容を明確にします。
          </p>
          <a class="button button--primary" href="/quote">見積依頼を開始</a>
        </div>
      </article>

      <aside class="resource-sidebar">
        <div class="sidebar-card">
          <h3>クイック情報</h3>
          <dl class="spec-dl">
            <div><dt>ガイドタイプ</dt><dd>{resource.type}</dd></div>
            <div><dt>言語</dt><dd>日本語</dd></div>
            <div><dt>用途</dt><dd>見積依頼の準備</dd></div>
          </dl>
        </div>
        <div class="sidebar-card sidebar-card--soft">
          <h3>その他のリソース</h3>
          <ul class="plain-links">
            {
              resources
                .filter((item) => item.slug !== resource.slug)
                .map((item) => <li><a href={`/resources/${item.slug}`}>{item.title} →</a></li>)
            }
            <li><a href="/products/abrasive-belts">研磨ベルト →</a></li>
            <li><a href="/industries">産業ソリューション →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles limit={3} />
    </div>
  </section>

  <CtaBand title="ガイドに載っていない質問はありますか？" text="技術的なお問い合わせをお送りください。適切な仕様推奨とともに回答します。" />
</Layout>