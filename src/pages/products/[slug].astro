---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqItem from '../../components/FaqItem.astro';
import StickyQuote from '../../components/StickyQuote.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { productCategories } from '../../data/site';
import { getModelByCategory } from '../../data/models';

export function getStaticPaths() {
  return productCategories.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = productCategories.filter((item) => item.slug !== product.slug).slice(0, 3);
const categoryModels = getModelByCategory(product.slug);
const breadcrumbs = [
  { name: 'ホーム', href: '/' },
  { name: '製品', href: '/products' },
  { name: product.name, href: `/products/${product.slug}` },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: new URL(product.image, Astro.site).href,
  brand: { '@type': 'Brand', name: 'MoTai Abrasives' },
  category: 'Abrasive Products',
  additionalProperty: product.specs.map(([name, value]) => ({
    '@type': 'PropertyValue',
    name,
    value,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title={`${product.name} | 墨泰の仕様と供給`}
  description={`墨泰の${product.name}：用途、参考仕様、対応オプション、購入者のための質問。お申し込みにあった製品の選択を支援。`}
  image={product.image}
  type="product"
  breadcrumbs={breadcrumbs}
  jsonLd={[productJsonLd, faqJsonLd]}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="product-hero">
    <div class="container product-hero__grid">
      <div class="product-hero__content">
        <span class="eyebrow">墨泰製品グループ</span>
        <h1>{product.title}</h1>
        <p>{product.description}</p>
        <ul class="hero__trust">
          <li>生産前に仕様確認</li>
          <li>サンプル対応（要望に応じて）</li>
          <li>OEMオプション</li>
        </ul>
        <div class="hero__actions">
          <a class="button button--accent" href={`/quote?product=${product.slug}`}>見積依頼</a>
          <a class="button button--ghost" href="#specs">仕様を見る</a>
        </div>
      </div>
      <figure class="product-hero__media">
        <img src={product.image} alt={`墨泰工場の${product.name}`} width="680" height="510" />
        <figcaption>商業包装または仕様確認後の独自ブランドでの供給に対応。</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--light product-overview">
    <div class="container product-overview__grid">
      <div class="product-overview__main">
        <div class="content-block">
          <span class="eyebrow">この製品を使うのはいつですか？</span>
          <h2>仕上げ用途に適しています</h2>
          <p>
            {product.name}は、仕上げ工程で再現可能な結果が必要なプロジェクトに対応します。
            製品の選定は、被削材・機械・要求グレードの特定から始まり、
            加工方法と予想数量に合わせ仕様を調整します。
          </p>
          <ul class="check-list check-list--large">
            <li>機械と取付方式に合う形状とサイズを選択。</li>
            <li>除去・仕上げ段階に応じた砥粒グレードまたは材質を決定。</li>
            <li>基材タイプと購入者の設備との互換性を確認。</li>
            <li>生産指示前に数量と包装を承認。</li>
          </ul>
        </div>

        <div class="content-block" id="specs">
          <span class="eyebrow">参考仕様</span>
          <h2>見積依頼の準備に役立つ技術情報</h2>
          <div class="table-wrap">
            <table>
              <caption>{product.name}の一般的な仕様。最終仕様は購入者と確認します。</caption>
              <thead><tr><th>項目</th><th>説明</th></tr></thead>
              <tbody>
                {product.specs.map(([name, value]) => <tr><th scope="row">{name}</th><td>{value}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="fine-print">
            最終要件は用途、機械、数量により異なります。数量を承認前に、正確な仕様と
            供給可否を確定するため、お問い合わせください。
          </p>
        </div>

        <div class="content-block">
          <span class="eyebrow">対応サイズ</span>
          <h2>機械に合うサイズを選択</h2>
          <p>
            各サイズで利用可能な砥粒グレード、基材タイプ、取付方式を明示。
            推測せずに見積依頼を準備できます。
          </p>
          <div class="model-list">
            {
              categoryModels.length ? (
                categoryModels.map((model) => (
                  <a class="model-list__item" href={`/products/models/${model.slug}`}>
                    <img src={model.image} alt="" width="96" height="72" loading="lazy" />
                    <span>
                      <strong>{model.name}</strong>
                      <small>{model.gritRange.length} 級の砥粒 · {model.backing}</small>
                    </span>
                    <span class="model-list__arrow">→</span>
                  </a>
                ))
              ) : (
                <p class="model-list__empty">
                  このグループは要求仕様に合わせて供給可能です — 見積フォームから機械に合う
                  サイズとグレードをお送りください。生産前に供給可否を確認します。
                </p>
              )
            }
          </div>
        </div>

        <div class="content-block">
          <span class="eyebrow">よくある質問</span>
          <h2>研磨材の購入者がよく尋ねる質問</h2>
          <div class="faq-list">
            {product.faq.map((item) => <FaqItem question={item.q} answer={item.a} />)}
          </div>
        </div>
      </div>

      <aside class="product-sidebar">
        <StickyQuote product={product.name} />
        <div class="sidebar-card">
          <h3>注文に役立つ情報</h3>
          <ul class="check-list">
            <li>製品タイプとサイズまたは直径</li>
            <li>砥粒グレードまたは材質</li>
            <li>機械と取付方式</li>
            <li>数量と発送先</li>
          </ul>
          <a class="text-link" href="/resources/abrasive-grit-guide">砥粒ガイドを見る <span>→</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <span class="eyebrow">関連製品</span>
          <h2>今回の依頼にもこれらの製品が合っています</h2>
        </div>
        <a class="button button--outline" href="/products">すべての製品を見る</a>
      </div>
      <div class="related-grid">
        {
          related.map((item) => (
            <a class="related-card" href={`/products/${item.slug}`}>
              <img src={item.image} alt="" width="320" height="220" loading="lazy" />
              <div><h3>{item.name}</h3><p>{item.description}</p><span>製品の詳細 →</span></div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <RelatedArticles productFamily={product.slug} />
    </div>
  </section>

  <CtaBand
    title={`${product.name}の見積は必要ですか？`}
    text="サイズ、数量、用途タイプをお送りください。仕様を検討し、明確な見積を用意します。"
  />
</Layout>