---
import { getCollection } from 'astro:content';

interface Props {
  productFamily?: string;
  industry?: string;
  limit?: number;
}

const { productFamily, industry, limit = 3 } = Astro.props;

const allArticles = await getCollection('articles');

const categoryLabels: Record<string, string> = {
  'product-comparison': '製品比較',
  'multi-product-comparison': '複数製品比較',
  'buying-guide': '購入ガイド',
  'technical-guide': '技術ガイド',
  'application-guide': '用途ガイド',
  'process-tutorial': 'プロセス解説',
  troubleshooting: 'トラブルシューティング',
  'product-spec-detail': '仕様詳細',
  'procurement-guide': '調達ガイド',
  'wholesale-oem-guide': '卸売とOEM',
  'industry-market': '業界市場',
  'gcc-regional-sourcing': 'GCC地域ソーシング',
  'faq-buyers-guide': '購入者FAQ',
};

const related = allArticles
  .filter(
    (a) =>
      (productFamily && a.data.productFamily === productFamily) ||
      (industry && a.data.industry === industry),
  )
  .slice(0, limit)
  .map((a) => ({
    id: a.id,
    title: a.data.title,
    description: a.data.description,
    category: a.data.category,
  }));
---

{
  related.length > 0 && (
    <div class="content-block">
      <span class="eyebrow">関連記事</span>
      <h2>続きを読む</h2>
      <div class="article-related-list">
        {related.map((rel) => (
          <a class="article-related-item" href={`/articles/${rel.id}`}>
            <span class="article-related-tag">{categoryLabels[rel.category] ?? rel.category}</span>
            <strong>{rel.title}</strong>
            <p>{rel.description.slice(0, 130)}…</p>
          </a>
        ))}
      </div>
      <a class="text-link" href="/articles" style="margin-block-start: 16px; display: inline-flex;">
        すべての記事 <span aria-hidden="true">→</span>
      </a>
    </div>
  )
}